# Working directory (worlds generated by skills)
# heavy generated assets stay local; small hand-edited / manifest JSON is tracked
worlds/**
!worlds/**/
!worlds/.gitkeep
!worlds/*/project.json
!worlds/*/scene.json
!worlds/*/image.json
!worlds/*/output/*/object.json
!worlds/*/output/world/*-world.json
worlds/*/archive/

# Input staging area
input/*
!input/.gitkeep

# App build output
node_modules/
app/dist/
app/node_modules/
app/.vite/

# Environment
.env

# OS
.DS_Store

# Blender autosave backups
*.blend1
